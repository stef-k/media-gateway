# Media Gateway example configuration.
#
# This file is documentation as well as a starting point for operators. Values shown
# here are examples, not hard-coded product assumptions. Copy it to a protected host
# path such as /etc/media-gateway/config.toml and adapt it for the deployment.
#
# internal/config implements this schema. Unknown, malformed or ambiguous values
# fail loading rather than being silently ignored. See docs/configuration.md.
#
# Never place provider credentials directly in this file or in Git. Store secrets in
# a separate restrictive file and reference that file by path. Install ownership
# and modes as documented in docs/deployment.md. TOML and key are loaded once:
# changes require a service restart; there is no hot reload.

[server]
# Local address used by the Go service. The application requires binding only to
# loopback and lets nginx own the external HTTP/HTTPS boundary. A numeric loopback
# IP and explicit port 1..65535 are required; hostnames are rejected.
listen = "127.0.0.1:2290"

# Public origin used when the application needs to construct absolute media URLs.
# This is deployment-specific: e.g. https://media.example.com or
# another operator-controlled origin. Optional: omit when absolute URLs are not needed.
# When supplied it must be an HTTP(S) origin without userinfo, query or fragment.
public_base_url = "https://media.example.com"

[provider]
# Provider adapter to use. V0 implements only Immich; this value is explicit so the
# configuration does not imply that provider behavior is generic or auto-detected.
type = "immich"

# Trusted Immich API origin as seen by Media Gateway. This is configured at startup
# and must never be overridden by a public request. It may be loopback, LAN-private,
# or another operator-controlled private address.
base_url = "http://127.0.0.1:2283"

# File containing the dedicated Immich API key, restricted to asset.read +
# asset.view + asset.download on a non-administrator account with access to the intended assets.
# The host service account must be able to read it; other local users should not.
# Do not put the key itself in this TOML file. Use an absolute normalized path to a regular file with owner-read
# permission and no group/other permissions. Install as media-gateway:media-gateway
# mode 0400 inside root-owned /etc/media-gateway (0750, group media-gateway).
# A root-owned 0640 key is rejected; group-read is forbidden. The key is one ASCII
# token, optionally followed by a newline, with a 4096-byte file limit.
api_key_file = "/etc/media-gateway/immich.key"

# Maximum duration for a normal provider HTTP request. Provider failure must remain
# bounded through metadata/search/preview bodies. For originals it bounds headers,
# not the body. Established image/video originals use fixed 60-second per-I/O
# read/write inactivity bounds, client cancellation and 10-second shutdown drain.
# There is no storage fallback or configurable delivery feature gate.
# Required positive Go duration; zero, negative, missing and overflowing values fail.
request_timeout = "15s"

[policy]
# Named provider-visible namespaces, never host/NAS mounts or paths opened locally.
# Names are unique 1..64 lowercase ASCII letters/digits/hyphens, with alphanumeric
# ends. Paths must already be canonical absolute POSIX paths other than /: no dot
# components, trailing/repeated slashes, backslashes or control characters.
# Paths must be unique and non-overlapping; /photos and /photos-old are distinct.
# Policy v2 replaces obsolete allowed_roots; stale V0 configuration fails startup.
[[policy.roots]]
name = "images"
path = "/media/archive"

# Publication rules match ONE exact normalized directory segment. `segment` is a
# configurable literal name, not a glob/regex/prefix. Operators may choose names such
# as "public", "website", or "share"; the implementation must compare exact path
# components only. Rules must have unique segment/scope pairs and non-empty, unique media
# lists containing only image/video. Pattern punctuation and separators are rejected.
#
# `media` declares which provider media types are eligible under this rule. A type
# must independently pass current lifecycle/policy on every public request. Both
# images and videos implement preview/original; only video originals accept Range.
[[policy.rules]]
segment = "public"
media = ["image", "video"]

# Omitted roots means global. A scoped rule uses roots = ["images"]; an empty
# list is invalid. References must exist and be unique. Root order is irrelevant.
# The same segment may have distinct scopes, combined with OR semantics (no deny
# rules or precedence). For example, an optional scoped legacy convention:
# [[policy.rules]]
# segment = "post"
# media = ["image"]
# roots = ["images"]

# Example image-only publication directory.
[[policy.rules]]
segment = "public-images"
media = ["image"]

# Example video-only publication directory. The rule may classify video as eligible,
# but delivery must still deny video until range/streaming delivery is implemented.
[[policy.rules]]
segment = "public-videos"
media = ["video"]

# Image preview/original are fixed routes, not configuration options. Remove any
# obsolete [delivery] section. Originals preserve source EXIF/GPS; use the separately
# qualified preview for web/privacy needs. Video delivery awaits #41.
