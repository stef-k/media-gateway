# Reference systemd unit for Media Gateway.
#
# Install using docs/deployment.md; qualify the sandbox on the target distribution.
# The static Go service uses network delivery and reads config/key and OS resolver/CA
# files. It needs no NAS mount, device, persistent data or cache directory.

[Unit]
# Human-readable service description shown by systemctl/status tooling.
Description=Media Gateway publication service

# Upstream documentation/source location for operators.
Documentation=https://github.com/stef-k/media-gateway

# Ask systemd to bring the network-online target into the transaction. Provider
# availability is not checked by the shell; this is ordering, not readiness.
Wants=network-online.target

# Start only after the network-online target has been reached.
After=network-online.target

# Stop retrying persistent startup failures after five starts within five minutes.
# After correcting configuration/permissions, use systemctl reset-failed then start.
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
# The Go binary remains in the foreground and systemd supervises that process.
Type=simple

# Dedicated unprivileged account. Create it as a system user with no interactive
# login and no membership in nginx/Immich/NAS administrative groups.
User=media-gateway
Group=media-gateway

# Binary and protected configuration path. Secrets referenced by the TOML file must
# be separately readable by this service account and not embedded in ExecStart.
ExecStart=/usr/local/bin/media-gateway -config /etc/media-gateway/config.toml

# Application logs are written by Go's log/slog to stdout/stderr. Keep ownership of
# persistence/indexing/rotation with systemd/journald instead of creating application
# log files. nginx separately owns the public HTTP access/error logs.
StandardOutput=journal
StandardError=journal

# Restart unexpected failures, but do not loop on a deliberate clean shutdown.
Restart=on-failure

# Back off briefly between restart attempts to avoid a tight failure loop.
RestartSec=5s

# systemd sends SIGTERM by default. The application drains for at most 10 seconds;
# allow scheduling/cleanup margin before the default final SIGKILL at 30 seconds.
TimeoutStopSec=30s

# Restrictive defaults for incidental file creation; the application requires no
# RuntimeDirectory, StateDirectory, CacheDirectory or LogsDirectory.
UMask=0077

# --- Baseline sandbox/hardening ---
# Compatible with the static, non-JIT Go application. Revalidate on the target
# kernel/systemd and after runtime changes; do not weaken protections to hide errors.

# Prevent the process and its children from acquiring additional privileges.
NoNewPrivileges=true

# Isolate /tmp and /var/tmp from other services. These remain writable private
# exceptions to ProtectSystem=strict; the application does not require temp files.
PrivateTmp=true

# Hide physical device nodes; the gateway has no device-access requirement.
PrivateDevices=true

# Make the host filesystem read-only (apart from private temporary/API filesystems).
# Config/key remain readable; no ReadWritePaths exception is required. This does not
# hide readable NAS mounts: host permissions must deny archive access (see docs).
ProtectSystem=strict

# Make user home directories inaccessible; credentials/config belong under /etc.
ProtectHome=true

# Block writes to kernel tunables and related /proc/sys interfaces.
ProtectKernelTunables=true

# Prevent loading/unloading kernel modules.
ProtectKernelModules=true

# Deny access to the kernel log buffer.
ProtectKernelLogs=true

# Protect cgroup configuration from the service.
ProtectControlGroups=true

# Prevent the service from changing the system/realtime clock.
ProtectClock=true

# Prevent setting SUID/SGID bits on files; NoNewPrivileges blocks privilege gains
# when executing an existing SUID/SGID binary.
RestrictSUIDSGID=true

# Prevent changing the process execution personality/domain.
LockPersonality=true

# Deny writable/executable mappings and executable transitions. The static Go
# application has no JIT, plugins or runtime code-generation requirement.
MemoryDenyWriteExecute=true

# Drop every Linux capability; binding to loopback on a high port requires none.
CapabilityBoundingSet=
AmbientCapabilities=

# Allow IPv4/IPv6 for numeric loopback listeners, DNS and private provider HTTP(S),
# and Unix sockets for local OS facilities. This is not a destination allowlist.
# Do not use PrivateNetwork: the provider and host loopback peers must remain reachable.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
# Enable the service as part of normal multi-user boot.
WantedBy=multi-user.target
